# Database (Postgres — e.g. a free Neon/Supabase project, or Vercel's own Postgres storage)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# File storage (optional locally — omit BLOB_READ_WRITE_TOKEN to store uploads on local disk in dev)
# In production (e.g. on Vercel) both are required so uploads persist.
# BLOB_READ_WRITE_TOKEN=""
# BLOB_BASE_URL="https://<store-id>.public.blob.vercel-storage.com"

# Email (optional — omit RESEND_API_KEY to just log emails to the console in dev)
RESEND_API_KEY=""
EMAIL_FROM="AngelsRadar <notifications@angelsradar.dev>"
ADMIN_NOTIFICATION_EMAIL="admin@angelsradar.dev"
